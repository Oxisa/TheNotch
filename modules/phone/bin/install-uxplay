#!/usr/bin/env bash
# Build UxPlay (an AirPlay screen-mirroring receiver, FDH2/UxPlay, GPL-3.0)
# for this user only: ~/.local/bin/uxplay. Every library it needs ships with
# Omarchy (libplist, Avahi's dns_sd, GStreamer, OpenSSL), so no root.
set -euo pipefail
TAG=v1.73.7
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
git clone -q --depth 1 --branch "$TAG" https://github.com/FDH2/UxPlay.git "$WORK/src"
cmake -S "$WORK/src" -B "$WORK/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$HOME/.local" >/dev/null
cmake --build "$WORK/build" -j"$(nproc)" >/dev/null
cmake --install "$WORK/build" >/dev/null
echo '{"ok":true}'
