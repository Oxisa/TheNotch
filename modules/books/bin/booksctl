#!/usr/bin/env -S python3 -I
"""Books for TheNotch: the books the desktop widget shows, with Foliate's progress.

  booksctl list [--flat] [--no-history] DIR...
      JSON {ok, books: [{path, title, author, cover, progress, read}]}:
      books in DIR (and subfolders unless --flat) plus the ones Foliate has
      opened (unless --no-history). progress is 0..1 or null (never opened),
      read is when Foliate last saved its place (unix time, 0 if never).
  booksctl open FILE
      opens FILE in Foliate.
  booksctl folders
      a folder picker (zenity); prints the chosen folders, one per line.

Foliate (3.x) keeps, per book identifier, ~/.local/share/<app>/<id>.json with
{metadata, progress: [page, pages], lastLocation}, maps identifiers to files
in library/uri-store.json, and caches covers as ~/.cache/<app>/<id>.png (ids
encoded like JS encodeURIComponent). Books it never opened are read here:
EPUB and FB2 metadata and covers, a CBZ's first image, else the file name.
"""
import base64, hashlib, json, os, re, subprocess, sys, time, urllib.parse, zipfile
import xml.etree.ElementTree as ET

APP = "com.github.johnfactotum.Foliate"
HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or HOME + "/.local/share", APP)
FCACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or HOME + "/.cache", APP)
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or HOME + "/.cache", "thenotch", "books")
EXT = (".epub", ".fb2", ".fbz", ".mobi", ".azw", ".azw3", ".cbz", ".pdf")


def enc(s):  # JavaScript's encodeURIComponent
    return urllib.parse.quote(s, safe="-_.!~*'()")


def text_of(v):
    """Foliate's metadata values: a string, a language map, a {name} or a list of those."""
    if v is None:
        return ""
    if isinstance(v, str):
        return v
    if isinstance(v, list):
        return ", ".join(t for t in (text_of(x) for x in v) if t)
    if isinstance(v, dict):
        if "name" in v:
            return text_of(v["name"])
        for k in ("ru", "en", "und"):
            if k in v:
                return text_of(v[k])
        return next((text_of(x) for x in v.values()), "")
    return str(v)


def uri_store():
    """file path -> Foliate identifier"""
    out = {}
    try:
        with open(os.path.join(DATA, "library", "uri-store.json")) as f:
            for ident, uri in json.load(f).get("uris", []):
                if uri.startswith("~"):
                    p = HOME + uri[1:]
                elif uri.startswith("file://"):
                    p = urllib.parse.unquote(uri[7:])
                else:
                    continue
                out[os.path.realpath(p)] = ident
    except (OSError, ValueError):
        pass
    return out


def foliate_data(ident):
    path = os.path.join(DATA, enc(ident) + ".json")
    try:
        with open(path) as f:
            return json.load(f), os.path.getmtime(path)
    except (OSError, ValueError):
        return None, 0


def save_cover(key, data, ext):
    os.makedirs(CACHE, exist_ok=True)
    out = os.path.join(CACHE, key + ext)
    with open(out, "wb") as f:
        f.write(data)
    return out


def epub_meta(path, key):
    title = author = cover = ""
    with zipfile.ZipFile(path) as z:
        cont = ET.fromstring(z.read("META-INF/container.xml"))
        opf_path = next(e.get("full-path") for e in cont.iter() if e.tag.endswith("rootfile"))
        opf = ET.fromstring(z.read(opf_path))
        base = os.path.dirname(opf_path)
        for e in opf.iter():
            tag = e.tag.split("}")[-1]
            if tag == "title" and not title and e.text:
                title = e.text.strip()
            elif tag == "creator" and not author and e.text:
                author = e.text.strip()
        items = [e for e in opf.iter() if e.tag.endswith("}item") or e.tag == "item"]
        href = ""
        for e in items:  # EPUB 3
            if "cover-image" in (e.get("properties") or "").split():
                href = e.get("href")
        if not href:  # EPUB 2: <meta name="cover" content="id">
            cid = next((e.get("content") for e in opf.iter() if e.tag.endswith("meta") and e.get("name") == "cover"), None)
            href = next((e.get("href") for e in items if cid and e.get("id") == cid), "")
        if not href:
            href = next((e.get("href") for e in items if "cover" in (e.get("id") or "").lower()
                         and (e.get("media-type") or "").startswith("image/")), "")
        if href:
            name = os.path.normpath(os.path.join(base, urllib.parse.unquote(href))).replace("\\", "/")
            try:
                cover = save_cover(key, z.read(name), os.path.splitext(name)[1].lower() or ".jpg")
            except KeyError:
                pass
    return title, author, cover


def fb2_meta(path, key):
    if path.endswith(".fbz"):
        with zipfile.ZipFile(path) as z:
            raw = z.read(next(n for n in z.namelist() if n.endswith(".fb2")))
    else:
        with open(path, "rb") as f:
            raw = f.read()
    root = ET.fromstring(raw)
    ns = {"f": root.tag.split("}")[0][1:]} if root.tag.startswith("{") else {}
    q = (lambda t: "f:" + t) if ns else (lambda t: t)
    info = root.find(f".//{q('title-info')}", ns)
    title = author = cover = ""
    if info is not None:
        t = info.find(q("book-title"), ns)
        title = (t.text or "").strip() if t is not None else ""
        a = info.find(q("author"), ns)
        if a is not None:
            parts = [(a.find(q(k), ns).text or "").strip() for k in ("first-name", "last-name")
                     if a.find(q(k), ns) is not None]
            author = " ".join(p for p in parts if p)
        img = info.find(f"{q('coverpage')}/{q('image')}", ns)
        if img is not None:
            ref = next((v for k, v in img.attrib.items() if k.endswith("href")), "").lstrip("#")
            for b in root.iter():
                if b.tag.endswith("binary") and b.get("id") == ref and b.text:
                    ext = ".png" if "png" in (b.get("content-type") or "") else ".jpg"
                    cover = save_cover(key, base64.b64decode(b.text), ext)
    return title, author, cover


def cbz_meta(path, key):
    with zipfile.ZipFile(path) as z:
        imgs = sorted(n for n in z.namelist() if re.search(r"\.(jpe?g|png|webp)$", n, re.I))
        cover = save_cover(key, z.read(imgs[0]), os.path.splitext(imgs[0])[1].lower()) if imgs else ""
    return "", "", cover


def own_meta(path, mtime, memo):
    """Title, author, cover from the file itself; remembered per path + mtime."""
    key = hashlib.md5(path.encode()).hexdigest()
    m = memo.get(path)
    if m and m.get("mtime") == mtime and (not m.get("cover") or os.path.exists(m["cover"])):
        return m
    title = author = cover = ""
    try:
        low = path.lower()
        if low.endswith(".epub"):
            title, author, cover = epub_meta(path, key)
        elif low.endswith((".fb2", ".fbz")):
            title, author, cover = fb2_meta(path, key)
        elif low.endswith(".cbz"):
            title, author, cover = cbz_meta(path, key)
    except Exception:
        pass
    m = {"mtime": mtime, "title": title, "author": author, "cover": cover}
    memo[path] = m
    return m


def find_books(dirs, flat):
    out = []
    for d in dirs:
        d = os.path.expanduser(d)
        if not os.path.isdir(d):
            continue
        for root, subdirs, files in os.walk(d, followlinks=True):
            subdirs[:] = [] if flat else sorted(s for s in subdirs if not s.startswith("."))
            out += [os.path.join(root, f) for f in sorted(files) if f.lower().endswith(EXT)]
    return out


def cmd_list(args):
    flat = "--flat" in args
    history = "--no-history" not in args
    dirs = [a for a in args if not a.startswith("--")]
    ids = uri_store()
    paths = find_books(dirs, flat)
    if history:
        paths += [p for p in ids if os.path.exists(p)]
    memo_path = os.path.join(CACHE, "meta.json")
    try:
        with open(memo_path) as f:
            memo = json.load(f)
    except (OSError, ValueError):
        memo = {}
    books, seen = [], set()
    for p in paths:
        real = os.path.realpath(p)
        if real in seen:
            continue
        seen.add(real)
        try:
            mtime = os.path.getmtime(real)
        except OSError:
            continue
        ident = ids.get(real)
        data, read = foliate_data(ident) if ident else (None, 0)
        meta = (data or {}).get("metadata") or {}
        mine = own_meta(real, mtime, memo)
        title = text_of(meta.get("title")) or mine["title"] or os.path.splitext(os.path.basename(real))[0]
        author = text_of(meta.get("author")) or mine["author"]
        cover = ""
        if ident and os.path.exists(os.path.join(FCACHE, enc(ident) + ".png")):
            cover = os.path.join(FCACHE, enc(ident) + ".png")
        cover = cover or mine["cover"]
        prog = (data or {}).get("progress")
        progress = (prog[0] + 1) / (prog[1] + 1) if isinstance(prog, list) and len(prog) == 2 and prog[1] else None
        books.append({"path": real, "title": title, "author": author, "cover": cover,
                      "progress": progress, "read": int(read)})
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(memo_path, "w") as f:
            json.dump(memo, f)
    except OSError:
        pass
    print(json.dumps({"ok": True, "books": books}, ensure_ascii=False))


def main():
    a = sys.argv[1:]
    if a[:1] == ["list"]:
        cmd_list(a[1:])
    elif a[:1] == ["folders"]:
        r = subprocess.run(["zenity", "--file-selection", "--directory", "--multiple",
                            "--separator=\n", "--title=Books"], capture_output=True, text=True)
        print(r.stdout, end="")
    elif a[:1] == ["open"] and len(a) > 1:
        subprocess.Popen(["foliate", a[1]], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print("usage: booksctl list [--flat] [--no-history] DIR... | open FILE | folders", file=sys.stderr)
        sys.exit(2)


main()
