#!/usr/bin/env python3
"""Stream system load for TheNotch's System widget: one JSON line every
INTERVAL seconds — cpu %, ram used/total, gpu % / vram / °C (NVIDIA via
nvidia-smi, or AMD via sysfs), cpu °C (k10temp / coretemp). Reads only
/proc, /sys and nvidia-smi; no network. Stops when stdout closes."""

import glob
import json
import os
import shutil
import subprocess
import sys
import time

INTERVAL = float(sys.argv[1]) if len(sys.argv) > 1 else 2.0


def cpu_times():
    with open("/proc/stat") as f:
        parts = f.readline().split()[1:]
    vals = list(map(int, parts))
    idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
    return idle, sum(vals)


def ram():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            info[k] = int(v.split()[0]) * 1024
    total = info.get("MemTotal", 0)
    used = total - info.get("MemAvailable", 0)
    return used, total


def hwmon_temp(names):
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            name = open(os.path.join(h, "name")).read().strip()
        except OSError:
            continue
        if name not in names:
            continue
        best = None
        for t in sorted(glob.glob(os.path.join(h, "temp*_input"))):
            label_file = t.replace("_input", "_label")
            label = open(label_file).read().strip() if os.path.exists(label_file) else ""
            v = int(open(t).read().strip()) / 1000
            if label in ("Tctl", "Package id 0", "Tdie") or best is None:
                best = v
                if label in ("Tctl", "Package id 0", "Tdie"):
                    break
        if best is not None:
            return round(best)
    return None


NVSMI = shutil.which("nvidia-smi")


def gpu():
    if NVSMI:
        try:
            out = subprocess.run([NVSMI, "--query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total,name",
                                  "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=3).stdout
            u, t, mu, mt, name = [x.strip() for x in out.splitlines()[0].split(",", 4)]
            return {"gpu": float(u), "gpuTemp": float(t), "vramUsed": float(mu) * 2**20, "vramTotal": float(mt) * 2**20,
                    "gpuName": name}
        except Exception:
            pass
    for card in glob.glob("/sys/class/drm/card*/device"):
        busy = os.path.join(card, "gpu_busy_percent")
        if os.path.exists(busy):
            try:
                g = {"gpu": float(open(busy).read()), "gpuTemp": hwmon_temp({"amdgpu"})}
                u = os.path.join(card, "mem_info_vram_used"), os.path.join(card, "mem_info_vram_total")
                if os.path.exists(u[0]):
                    g["vramUsed"], g["vramTotal"] = float(open(u[0]).read()), float(open(u[1]).read())
                return g
            except Exception:
                pass
    return {}


def net_bytes():
    """rx, tx summed over real network cards (those with a device behind them)."""
    rx = tx = 0
    with open("/proc/net/dev") as f:
        for line in f.readlines()[2:]:
            name, data = line.split(":", 1)
            name = name.strip()
            if not os.path.exists(f"/sys/class/net/{name}/device"):
                continue
            v = data.split()
            rx += int(v[0]); tx += int(v[8])
    return rx, tx


def disks():
    """Used/total for / and every other real mount (no snapshots or tmpfs)."""
    seen, out = set(), []
    with open("/proc/mounts") as f:
        for line in f:
            dev, mnt, fs = line.split()[:3]
            if not dev.startswith("/dev/") or fs in ("squashfs", "iso9660") or mnt.startswith(("/boot", "/snap", "/var/lib", "/.snapshots")):
                continue
            try:
                st = os.statvfs(mnt)
            except OSError:
                continue
            key = (st.f_blocks, st.f_bfree)
            if key in seen or st.f_blocks == 0:
                continue
            seen.add(key)
            total = st.f_blocks * st.f_frsize
            out.append({"mount": mnt, "used": total - st.f_bavail * st.f_frsize, "total": total})
    return out


def main():
    idle0, total0 = cpu_times()
    rx0, tx0 = net_bytes()
    t0 = time.monotonic()
    n = 0
    while True:
        time.sleep(INTERVAL)
        idle1, total1 = cpu_times()
        d_total, d_idle = total1 - total0, idle1 - idle0
        idle0, total0 = idle1, total1
        used, total = ram()
        rec = {"cpu": round(100 * (1 - d_idle / d_total), 1) if d_total else 0,
               "cpuTemp": hwmon_temp({"k10temp", "coretemp", "zenpower"}),
               "ramUsed": used, "ramTotal": total}
        rec.update(gpu())
        rx1, tx1 = net_bytes(); t1 = time.monotonic()
        rec["down"], rec["up"] = (rx1 - rx0) / (t1 - t0), (tx1 - tx0) / (t1 - t0)
        rx0, tx0, t0 = rx1, tx1, t1
        if n % 15 == 0:                               # disks change slowly
            dk = disks()
        rec["disks"] = dk
        with open("/proc/uptime") as f:
            rec["uptime"] = int(float(f.read().split()[0]))
        n += 1
        try:
            print(json.dumps(rec), flush=True)
        except BrokenPipeError:
            return


if __name__ == "__main__":
    main()
