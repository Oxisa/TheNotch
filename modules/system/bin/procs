#!/usr/bin/env python3
"""Processes for TheNotch's task manager, btop-style: every 2 s one JSON line
with per-core load and the processes grouped by app (name), CPU % from the
difference between two looks at /proc (not ps's lifetime average), memory
as RSS. Only your own processes can be ended from the UI; the list shows
all. Stops when stdout closes."""
import json, os, pwd, sys, time

HZ = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
NCPU = os.cpu_count() or 1
ME = os.getuid()

def cores():
    out = []
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("cpu") and line[3].isdigit():
                v = list(map(int, line.split()[1:]))
                idle = v[3] + v[4]
                out.append((sum(v), idle))
    return out

def procs():
    res = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                s = f.read()
            name = s[s.index("(") + 1:s.rindex(")")]
            # an app's helpers ("Isolated Web Co", "Web Content") count as the app
            try:
                exe = os.path.basename(os.readlink(f"/proc/{d}/exe")).split(" ")[0]
                if exe and exe not in ("bash", "sh", "python3", "python", "node", "electron") and not exe.startswith("python"):
                    name = exe
            except OSError:
                pass
            rest = s[s.rindex(")") + 2:].split()
            ticks = int(rest[11]) + int(rest[12])
            rss = int(rest[21]) * PAGE
            uid = os.stat(f"/proc/{d}").st_uid
            res[int(d)] = (name, ticks, rss, uid)
        except (OSError, ValueError, IndexError):
            pass
    return res

users = {}
def user(uid):
    if uid not in users:
        try:
            users[uid] = pwd.getpwuid(uid).pw_name
        except KeyError:
            users[uid] = str(uid)
    return users[uid]

prev_c, prev_p, prev_t = cores(), procs(), time.monotonic()
while True:
    time.sleep(2)
    now_c, now_p, now_t = cores(), procs(), time.monotonic()
    dt = max(0.1, now_t - prev_t)
    per = []
    for (t1, i1), (t0, i0) in zip(now_c, prev_c):
        dtot = t1 - t0
        per.append(round(100 * (1 - (i1 - i0) / dtot), 1) if dtot > 0 else 0)
    groups = {}
    for pid, (name, ticks, rss, uid) in now_p.items():
        before = prev_p.get(pid)
        cpu = 100 * (ticks - before[1]) / HZ / dt / NCPU if before and before[0] == name else 0
        g = groups.setdefault((name, uid), {"name": name, "user": user(uid), "mine": uid == ME, "cpu": 0, "mem": 0, "pids": []})
        g["cpu"] += cpu
        g["mem"] += rss
        g["pids"].append(pid)
    lst = sorted(groups.values(), key=lambda g: (-g["cpu"], -g["mem"]))[:80]
    for g in lst:
        g["cpu"] = round(g["cpu"], 1)
        g["count"] = len(g["pids"])
    try:
        print(json.dumps({"cores": per, "procs": lst, "total": len(now_p)}), flush=True)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
    prev_c, prev_p, prev_t = now_c, now_p, now_t
