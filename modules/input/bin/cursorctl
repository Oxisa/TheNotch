#!/usr/bin/env python3
"""Cursor themes for TheNotch: list them with previews, apply one, import a
Windows cursor pack (.zip with .ani/.cur files) as an Xcursor theme.

  list                    themes with cursors (system, yours, the Cursor
                          Accent plugin's), each with a preview picture
  current                 what is set now
  apply NAME [SIZE]       set it now (hyprctl setcursor, GTK) and keep it:
                          an env block in ~/.config/hypr/looknfeel.lua and an
                          Omarchy post-boot hook re-apply it at every login
  import ZIP [NAME]       convert the .ani/.cur files to an Xcursor theme in
                          ~/.local/share/icons/NAME (animations kept; small
                          pixel art is enlarged without blurring)
  delete NAME             remove a theme you imported
  downloads               cursor packs (.zip with .ani/.cur) in ~/Downloads not imported yet
  accent [BASE] [COLOR] [VARIANT]
                          "in the theme's colour": recolour a theme (TheNotch's
                          own rounded set by default) into TheNotch-Accent —
                          VARIANT fill | tone | outline | light says what gets
                          COLOR (the Omarchy theme's accent when "theme") —
                          and apply it; a theme-set hook rebuilds it on every
                          theme change
  reimport                rebuild imported packs in every size
  accent-refresh          rebuild for the current theme (the hook runs this)

Packs are converted for your own use on this computer; many authors forbid
re-sharing them. Every command prints one JSON object.
"""
import configparser, io, json, os, re, shutil, struct, subprocess, sys, tempfile, zipfile
from pathlib import Path

HOME = Path.home()
USER_ICONS = HOME / ".local/share/icons"
DIRS = [USER_ICONS, HOME / ".icons", Path("/usr/share/icons")]
CACHE = HOME / ".cache/thenotch/cursors"
STATE = HOME / ".config/thenotch/cursor.json"
LOOK = HOME / ".config/hypr/looknfeel.lua"
HOOK = HOME / ".config/omarchy/hooks/post-boot.d/thenotch-cursor"
BEGIN, END = "-- BEGIN thenotch-cursor", "-- END thenotch-cursor"
ACCENT = "TheNotch-Accent"
# every size a theme is built in: the pointer follows the size slider in even
# steps (a pack with one or two sizes would jump or not change at all)
SIZES = (16, 24, 32, 40, 48, 56, 64, 80, 96)
OURS = "TheNotch"
ACCENT_HOOK = HOME / ".config/omarchy/hooks/theme-set.d/thenotch-cursor-accent"
# the hook calls this script through the installed plugin, wherever it was run from
_INSTALLED = HOME / ".config/omarchy/plugins/osia.thenotch/modules/input/bin/cursorctl"
SELF = _INSTALLED if _INSTALLED.exists() else Path(__file__).resolve()
COLORS = HOME / ".local/state/omarchy/current/theme/colors.toml"

# Windows roles → the Xcursor names apps ask for
ROLES = {
    "pointer": ["left_ptr", "default", "arrow", "top_left_arrow", "left_arrow"],
    "help": ["help", "question_arrow", "whats_this", "left_ptr_help"],
    "working": ["progress", "left_ptr_watch", "half-busy"],
    "busy": ["wait", "watch"],
    "text": ["text", "xterm", "ibeam"],
    "link": ["pointer", "hand", "hand1", "hand2", "pointing_hand"],
    "precision": ["crosshair", "cross", "tcross"],
    "move": ["move", "fleur", "all-scroll", "size_all"],
    "unavailable": ["not-allowed", "no-drop", "crossed_circle", "forbidden"],
    "vert": ["ns-resize", "size_ver", "v_double_arrow", "sb_v_double_arrow", "n-resize", "s-resize"],
    "horz": ["ew-resize", "size_hor", "h_double_arrow", "sb_h_double_arrow", "e-resize", "w-resize"],
    "dgn1": ["nwse-resize", "size_fdiag", "nw-resize", "se-resize", "bd_double_arrow"],
    "dgn2": ["nesw-resize", "size_bdiag", "ne-resize", "sw-resize", "fd_double_arrow"],
    "handwriting": ["pencil"],
    "alternate": ["up-arrow", "center_ptr"],
}
WORDS = {  # file-name hints when the pack has no install.inf
    "pointer": ["normal", "arrow", "pointer", "default", "select"], "help": ["help"], "working": ["working", "appstarting", "background"],
    "busy": ["busy", "wait"], "text": ["text", "ibeam", "beam"], "link": ["link", "hand"], "precision": ["precision", "cross"],
    "move": ["move"], "unavailable": ["unavailable", "no", "forbidden"], "vert": ["vert", "ns"], "horz": ["horz", "ew"],
    "dgn1": ["dgn1", "nwse"], "dgn2": ["dgn2", "nesw"], "handwriting": ["handwriting", "pen"], "alternate": ["alternate", "alt"],
}


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))
    return 0 if obj.get("ok", True) else 1


def run(args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


# ---------------------------------------------------------------- Xcursor
def read_xcursor(path):
    """The biggest first-frame image: (w, h, argb bytes)."""
    d = path.read_bytes()
    if d[:4] != b"Xcur":
        return None
    ntoc = struct.unpack("<I", d[12:16])[0]
    best = None
    for i in range(ntoc):
        typ, sub, pos = struct.unpack("<III", d[16 + 12 * i:28 + 12 * i])
        if typ != 0xFFFD0002:
            continue
        w, h = struct.unpack("<II", d[pos + 16:pos + 24])
        if best is None or w > best[0]:
            best = (w, h, d[pos + 36:pos + 36 + w * h * 4])
    return best


def write_xcursor(path, images):
    """images: [(size, w, h, xhot, yhot, delay_ms, argb_bytes)]"""
    n = len(images)
    head = struct.pack("<4sIII", b"Xcur", 16, 0x10000, n)
    toc, body, pos = b"", b"", 16 + 12 * n
    for size, w, h, xh, yh, delay, px in images:
        chunk = struct.pack("<IIIIIIIII", 36, 0xFFFD0002, size, 1, w, h, xh, yh, delay) + px
        toc += struct.pack("<III", 0xFFFD0002, size, pos)
        body += chunk
        pos += len(chunk)
    path.write_bytes(head + toc + body)


def read_xcursor_all(path):
    """Every image (all sizes, all frames): [(size, w, h, xhot, yhot, delay, argb)]."""
    d = path.read_bytes()
    if d[:4] != b"Xcur":
        return []
    ntoc = struct.unpack("<I", d[12:16])[0]
    res = []
    for i in range(ntoc):
        typ, sub, pos = struct.unpack("<III", d[16 + 12 * i:28 + 12 * i])
        if typ != 0xFFFD0002:
            continue
        _, _, size, _, w, h, xh, yh, delay = struct.unpack("<IIIIIIIII", d[pos:pos + 36])
        res.append((size, w, h, xh, yh, delay, d[pos + 36:pos + 36 + w * h * 4]))
    return res


def theme_accent():
    try:
        m = re.search(r'^\s*accent\s*=\s*"(#[0-9a-fA-F]{6})"', COLORS.read_text(), re.M)
        return m.group(1) if m else "#888888"
    except OSError:
        return "#888888"


def mix(c1, c2, k):
    a, b = [int(c1[i:i + 2], 16) for i in (1, 3, 5)], [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * k):02x}" for x, y in zip(a, b))


# how the colour is laid on: (body, outline) of the pointer
VARIANTS = {
    "fill":    lambda c: (c, "#ffffff"),               # coloured, white edge
    "tone":    lambda c: (c, mix(c, "#000000", 0.55)), # coloured, a darker edge of the same colour
    "outline": lambda c: ("#16161a", c),               # dark, coloured edge
    "light":   lambda c: ("#ffffff", c),               # white, coloured edge
}


def recolour(px, body, edge):
    """Premultiplied BGRA: the theme's dark body → body, its light edge → edge
    (in between: blended); the soft dark shadow stays as it is."""
    b0 = [int(body[i:i + 2], 16) for i in (5, 3, 1)]
    e0 = [int(edge[i:i + 2], 16) for i in (5, 3, 1)]
    out = bytearray(px)
    for i in range(0, len(px), 4):
        a = px[i + 3]
        if not a:
            continue
        b, g, r = px[i] * 255 // a, px[i + 1] * 255 // a, px[i + 2] * 255 // a
        lum = (r * 299 + g * 587 + b * 114) // 1000          # 0 dark … 255 light
        if a < 200 and lum < 96:                              # shadow
            continue
        for k in range(3):
            out[i + k] = (b0[k] + (e0[k] - b0[k]) * lum // 255) * a // 255
    return bytes(out)


# ------------------------------------------------- our own pointer set
# Drawn here (MIT, TheNotch's): the shapes in a 32×32 box, rounded like
# Windows 11's — round joins, round ends. Body black, edge white, a soft
# shadow; "in the theme's colour" recolours it like any other theme.
ARROW = "M5,3.5 L5,24.5 L10.2,19.6 L13.6,27.4 L17.2,25.9 L13.9,18.3 L21,18.3 Z"
DOUBLE = "M3.5,16 L9.5,10 L9.5,13.8 L22.5,13.8 L22.5,10 L28.5,16 L22.5,22 L22.5,18.2 L9.5,18.2 L9.5,22 Z"
HAND = [("rect", 11.2, 2.6, 4.4, 15, 2.2), ("rect", 15.2, 10.2, 4, 9, 2), ("rect", 18.7, 11.2, 3.8, 8.5, 1.9),
        ("rect", 21.9, 12.6, 3.4, 7.5, 1.7), ("rect", 9.5, 14.5, 15.8, 13.5, 5),
        ("rot", 4.2, 15.4, 4, 9.5, 2, -38, 7, 19.5)]


def shapes(name, frame=0, frames=1):
    """→ ([primitives], (xhot, yhot)); a primitive is (kind, …)."""
    spin = lambda cx, cy, r, w: [("arc", cx, cy, r, w, frame * 360 / frames)]
    if name == "arrow":
        return [("path", ARROW)], (5, 3.5)
    if name == "hand":
        return HAND, (13.4, 2.8)
    if name == "text":
        return [("rect", 10.5, 3.5, 11, 3, 1.5), ("rect", 14.6, 4, 2.8, 24, 1.4), ("rect", 10.5, 25.5, 11, 3, 1.5)], (16, 16)
    if name == "cross":
        return [("rect", 15, 3, 2, 26, 1), ("rect", 3, 15, 26, 2, 1)], (16, 16)
    if name == "no":
        return [("ring", 16, 16, 11, 3.2), ("rot", 14.4, 5.5, 3.2, 21, 1.6, -45, 16, 16)], (16, 16)
    if name == "wait":
        return spin(16, 16, 9, 4), (16, 16)
    if name == "progress":
        return [("path", ARROW)] + spin(23.5, 23.5, 4.6, 2.6), (5, 3.5)
    if name == "help":
        return [("path", ARROW), ("line", "M20.5,21.2 a3.6,3.6 0 1,1 4.6,3.4 v1.8", 2.6), ("dot", 25.1, 29.2, 1.5)], (5, 3.5)
    if name == "move":
        heads = [("rotp", "M16,2.8 L21.2,8.6 L10.8,8.6 Z", d) for d in (0, 90, 180, 270)]
        return [("rect", 14.6, 7, 2.8, 18, 1.2), ("rect", 7, 14.6, 18, 2.8, 1.2)] + heads, (16, 16)
    if name in ("ew", "ns", "nwse", "nesw"):
        deg = {"ew": 0, "ns": 90, "nwse": 45, "nesw": -45}[name]
        return [("rotp", DOUBLE, deg)], (16, 16)
    return [], (0, 0)


def svg(prims, layer, body="#000", edge="#fff", ew=1.6):
    """layer: "edge" — every shape grown by ew in the edge colour; "body" — the
    shapes themselves; "shadow" — the edge shape, soft and dark."""
    col = edge if layer == "edge" else body if layer == "body" else "#000"
    grow = layer != "body"
    st = f' stroke="{col}" stroke-width="{2 * ew}" stroke-linejoin="round" stroke-linecap="round"' if grow else ""
    out = []
    for p in prims:
        k = p[0]
        if k == "path":
            out.append(f'<path d="{p[1]}" fill="{col}"{st}/>')
        elif k == "rotp":
            out.append(f'<path d="{p[1]}" fill="{col}"{st} transform="rotate({p[2]} 16 16)"/>')
        elif k == "rect":
            _, x, y, w, h, rx = p
            out.append(f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{rx}" fill="{col}"{st}/>')
        elif k == "rot":
            _, x, y, w, h, rx, deg, cx, cy = p
            out.append(f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{rx}" fill="{col}"{st} transform="rotate({deg} {cx} {cy})"/>')
        elif k == "ring":
            _, cx, cy, rr, w = p
            out.append(f'<circle cx="{cx}" cy="{cy}" r="{rr}" fill="none" stroke="{col}" stroke-width="{w + (2 * ew if grow else 0)}"/>')
        elif k == "line":
            _, d, w = p
            out.append(f'<path d="{d}" fill="none" stroke="{col}" stroke-width="{w + (2 * ew if grow else 0)}" stroke-linecap="round" stroke-linejoin="round"/>')
        elif k == "dot":
            _, cx, cy, rr = p
            out.append(f'<circle cx="{cx}" cy="{cy}" r="{rr + (ew if grow else 0)}" fill="{col}"/>')
        elif k == "arc":                                   # three quarters of a ring, turning
            _, cx, cy, rr, w, deg = p
            out.append(f'<circle cx="{cx}" cy="{cy}" r="{rr}" fill="none" stroke="{col}" stroke-opacity="{0.35 if layer == "body" else 1}" stroke-width="{w + (2 * ew if grow else 0)}"/>')
            if layer == "body":
                out.append(f'<path d="M{cx},{cy - rr} A{rr},{rr} 0 1,1 {cx - rr},{cy}" fill="none" stroke="{col}" stroke-width="{w}" stroke-linecap="round" transform="rotate({deg} {cx} {cy})"/>')
    g = "".join(out)
    if layer == "shadow":
        return f'<g opacity="0.35" filter="url(#s)" transform="translate(0.5 1)">{g}</g>'
    return f"<g>{g}</g>"


def render_ours(name, size, frame=0, frames=1):
    prims, hot = shapes(name, frame, frames)
    doc = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">'
           '<defs><filter id="s" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="0.8"/></filter></defs>'
           + svg(prims, "shadow") + svg(prims, "edge") + svg(prims, "body") + "</svg>")
    r = subprocess.run(["rsvg-convert", "-w", str(size), "-h", str(size), "-f", "png"], input=doc.encode(), capture_output=True)
    rgba = magick_rgba(r.stdout, "png")
    return (size, size, size, round(hot[0] * size / 32), round(hot[1] * size / 32), 0, rgba_to_argb(rgba))


OUR_SET = {  # our shape → the Xcursor names it serves (the rest come from Adwaita)
    "arrow": ROLES["pointer"], "hand": ROLES["link"], "text": ROLES["text"], "cross": ROLES["precision"],
    "no": ROLES["unavailable"], "wait": ROLES["busy"], "progress": ROLES["working"], "help": ROLES["help"],
    "move": ROLES["move"], "ns": ROLES["vert"], "ew": ROLES["horz"] + ["col-resize"], "nwse": ROLES["dgn1"], "nesw": ROLES["dgn2"],
}
OURS_VERSION = "2"


def build_ours():
    """~/.local/share/icons/TheNotch — drawn once (again when the drawing changes)."""
    dst = USER_ICONS / OURS
    if (dst / ".thenotch-ours").exists() and (dst / ".thenotch-ours").read_text() == OURS_VERSION:
        return
    shutil.rmtree(dst, ignore_errors=True)
    (dst / "cursors").mkdir(parents=True)
    for shape, names in OUR_SET.items():
        frames = 12 if shape in ("wait", "progress") else 1
        imgs = []
        for size in SIZES:
            for f in range(frames):
                im = render_ours(shape, size, f, frames)
                imgs.append(im[:5] + (60 if frames > 1 else 0, im[6]))
        write_xcursor(dst / "cursors" / names[0], imgs)
        for alias in names[1:]:
            (dst / "cursors" / alias).symlink_to(names[0])
    (dst / "index.theme").write_text(f"[Icon Theme]\nName={OURS}\nComment=TheNotch's rounded pointers\nInherits=Adwaita\n")
    (dst / ".thenotch-ours").write_text(OURS_VERSION)


def theme_dir(name):
    return next((d / name for d in DIRS if (d / name / "cursors").is_dir()), None)


def build_accent(base, colour, variant="fill", max_size=128):
    if base == OURS:
        build_ours()
    src = theme_dir(base)
    if not src:
        return f"no cursor theme {base}"
    body, edge = VARIANTS.get(variant, VARIANTS["fill"])(colour)
    dst = USER_ICONS / ACCENT
    if dst.exists():
        shutil.rmtree(dst)
    (dst / "cursors").mkdir(parents=True)
    cache = {}
    # the theme's own cursors, then what it leaves to Adwaita — all in one colour
    chain = [src] + ([theme_dir("Adwaita")] if base != "Adwaita" and theme_dir("Adwaita") else [])
    for theme in chain:
        for f in sorted((theme / "cursors").iterdir()):
            target = dst / "cursors" / f.name
            if target.exists() or target.is_symlink():
                continue
            if f.is_symlink() and theme is src:              # names that point at another cursor
                os.symlink(os.readlink(f), target)
                continue
            real = f.resolve()
            if real in cache:
                shutil.copyfile(cache[real], target)
                continue
            imgs = [im for im in read_xcursor_all(real) if im[0] <= max_size] or read_xcursor_all(real)
            if not imgs:
                continue
            write_xcursor(target, [im[:6] + (recolour(im[6], body, edge),) for im in imgs])
            cache[real] = target
    (dst / "index.theme").write_text(f"[Icon Theme]\nName={ACCENT}\nComment=TheNotch: {base} in {colour}\nInherits={base},Adwaita\n")
    (dst / ".thenotch-accent").write_text(json.dumps({"base": base, "colour": colour, "variant": variant}))
    return ""


def accent_state():
    try:
        return json.loads(STATE.read_text()).get("accent") or {}
    except (OSError, ValueError):
        return {}


def accent(base=None, colour=None, size=None, variant=None):
    st = accent_state()
    base = base or st.get("base") or OURS
    mode = colour or st.get("colour") or "theme"
    variant = variant or st.get("variant") or "fill"
    err = build_accent(base, theme_accent() if mode == "theme" else mode, variant)
    if err:
        return out({"ok": False, "error": err})
    size = size or current()["size"]
    r = run(["hyprctl", "setcursor", ACCENT, str(size)])
    persist(ACCENT, size)
    data = json.loads(STATE.read_text()); data["accent"] = {"base": base, "colour": mode, "variant": variant}; STATE.write_text(json.dumps(data))
    run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", ACCENT])
    # follow the Omarchy theme: rebuilt on every `omarchy theme set`
    ACCENT_HOOK.parent.mkdir(parents=True, exist_ok=True)
    ACCENT_HOOK.write_text(f"#!/bin/bash\n# TheNotch: the cursor in the theme's colour\n{json.dumps(str(SELF))} accent-refresh >/dev/null 2>&1 &\n")
    ACCENT_HOOK.chmod(0o755)
    return out({"ok": r.returncode == 0, "error": r.stderr.strip()})


def rgba_to_argb(rgba):
    """ImageMagick's RGBA → Xcursor's premultiplied ARGB (little-endian BGRA)."""
    out = bytearray(len(rgba))
    for i in range(0, len(rgba), 4):
        r, g, b, a = rgba[i], rgba[i + 1], rgba[i + 2], rgba[i + 3]
        out[i:i + 4] = bytes(((b * a) // 255, (g * a) // 255, (r * a) // 255, a))
    return bytes(out)


def magick_rgba(data, ext, size=None, pixel=False):
    with tempfile.NamedTemporaryFile(suffix="." + ext) as f:
        f.write(data); f.flush()
        args = ["magick", f"{ext}:{f.name}[0]", "-background", "none"]
        if size:
            args += (["-filter", "point"] if pixel else []) + ["-resize", f"{size}x{size}!"]
        r = subprocess.run(args + ["-depth", "8", "rgba:-"], capture_output=True)
        return r.stdout


# ---------------------------------------------------------------- packs
def cur_frames(data):
    """A .cur or .ani file → [(cur_bytes, w, h, xhot, yhot, delay_ms)]."""
    def one(c):
        _, typ, cnt = struct.unpack("<HHH", c[:6])
        w, h, _, _, xh, yh, _, _ = struct.unpack("<BBBBHHII", c[6:22])
        return (c, w or 256, h or 256, xh, yh)
    if data[:4] == b"RIFF" and data[8:12] == b"ACON":
        frames, rate, seq, jif = [], None, None, 6
        i = 12
        while i < len(data) - 8:
            cid = data[i:i + 4]; sz = struct.unpack("<I", data[i + 4:i + 8])[0]
            if cid == b"LIST":
                i += 12; continue
            body = data[i + 8:i + 8 + sz]
            if cid == b"anih":
                jif = struct.unpack("<9I", body[:36])[7] or 6
            elif cid == b"rate":
                rate = list(struct.unpack(f"<{sz // 4}I", body))
            elif cid == b"seq ":
                seq = list(struct.unpack(f"<{sz // 4}I", body))
            elif cid == b"icon":
                frames.append(one(body))
            i += 8 + sz + (sz & 1)
        order = seq or list(range(len(frames)))
        res = []
        for k, fi in enumerate(order):
            if fi < len(frames):
                c, w, h, xh, yh = frames[fi]
                j = rate[k] if rate and k < len(rate) else jif
                res.append((c, w, h, xh, yh, max(16, int(j * 1000 / 60))))
        return res
    c, w, h, xh, yh = one(data)
    return [(c, w, h, xh, yh, 0)]


def roles_from_inf(files):
    """[Strings] of a Windows install.inf: pointer = "Normal.ani" …"""
    for name, data in files.items():
        if name.lower().endswith(".inf"):
            text = data.decode("utf-8", "ignore")
            m = re.search(r"\[Strings\](.*?)(?:\n\[|\Z)", text, re.S | re.I)
            if not m:
                continue
            res = {}
            for line in m.group(1).splitlines():
                kv = re.match(r'\s*(\w+)\s*=\s*"?([^"]+?)"?\s*$', line)
                if kv and kv.group(1).lower() in ROLES:
                    res[kv.group(1).lower()] = Path(kv.group(2)).name.lower()
            if res:
                return res
    return {}


def import_zip(zpath, name=None):
    z = zipfile.ZipFile(zpath)
    files = {n: z.read(n) for n in z.namelist() if not n.endswith("/")}
    cursors = {Path(n).name.lower(): d for n, d in files.items() if n.lower().endswith((".ani", ".cur"))}
    if not cursors:
        return out({"ok": False, "error": "no .ani or .cur files in the archive"})
    roles = roles_from_inf(files)
    for role, words in WORDS.items():                   # fill the rest from file names
        if role in roles:
            continue
        for fname in cursors:
            stem = Path(fname).stem.lower()
            if any(stem == w or (len(w) >= 4 and stem.startswith(w)) for w in words):
                roles[role] = fname
                break
    if "pointer" not in roles:
        roles["pointer"] = sorted(cursors)[0]
    if "working" in roles and "busy" not in roles:
        roles["busy"] = roles["working"]
    if not name:
        stem = re.sub(r"(?i)\b(trial|free|full)\s+version\b", "", Path(zpath).stem)
        name = re.sub(r"\s+", " ", re.sub(r"[^\w ]+", " ", stem)).strip() or "Imported"
    theme = USER_ICONS / name
    shutil.rmtree(theme, ignore_errors=True)
    (theme / "cursors").mkdir(parents=True)
    for role, fname in roles.items():
        frames = cur_frames(cursors[fname])
        images = []
        src = max(f[1] for f in frames)
        pixel = src <= 48                                   # small pixel art: enlarge without blur
        for size in sorted(set(SIZES) | {src}):
            k = size / src
            for c, w, h, xh, yh, delay in frames:
                rgba = magick_rgba(c, "cur", size if size != src else None, pixel)
                tw = th = size if size != src else w
                if len(rgba) != tw * th * 4:
                    continue
                images.append((size, tw, th, min(tw - 1, round(xh * k)), min(th - 1, round(yh * k)), delay, rgba_to_argb(rgba)))
        if not images:
            continue
        first = theme / "cursors" / ROLES[role][0]
        write_xcursor(first, images)
        for alias in ROLES[role][1:]:
            link = theme / "cursors" / alias
            if not link.exists():
                link.symlink_to(first.name)
    (theme / "index.theme").write_text(f"[Icon Theme]\nName={name}\nComment=Imported by TheNotch from {Path(zpath).name}\nInherits=Adwaita\n")
    (theme / ".thenotch-imported").write_text(str(zpath))
    return out({"ok": True, "name": name, "roles": sorted(roles)})


# ---------------------------------------------------------------- themes
def preview(theme_dir):
    CACHE.mkdir(parents=True, exist_ok=True)
    png = CACHE / (theme_dir.name + ".png")
    if png.exists() and png.stat().st_mtime >= theme_dir.stat().st_mtime:
        return str(png)
    for nm in ("left_ptr", "default", "arrow"):
        p = theme_dir / "cursors" / nm
        if p.exists():
            img = read_xcursor(p.resolve())
            if img:
                w, h, argb = img
                rgba = bytearray(len(argb))
                for i in range(0, len(argb), 4):
                    b, g, r, a = argb[i:i + 4]
                    if a:
                        r, g, b = min(255, r * 255 // a), min(255, g * 255 // a), min(255, b * 255 // a)
                    rgba[i:i + 4] = bytes((r, g, b, a))
                subprocess.run(["magick", "-size", f"{w}x{h}", "-depth", "8", "rgba:-", str(png)], input=bytes(rgba), capture_output=True)
                return str(png) if png.exists() else ""
    hlc = theme_dir / "hyprcursors" / "left_ptr.hlc"
    if hlc.exists():
        try:
            z = zipfile.ZipFile(hlc)
            for n in z.namelist():
                if n.endswith((".svg", ".png")):
                    data = z.read(n)
                    with tempfile.NamedTemporaryFile(suffix=Path(n).suffix) as f:
                        f.write(data); f.flush()
                        subprocess.run(["magick", "-background", "none", f.name, "-resize", "64x64", str(png)], capture_output=True)
                    return str(png) if png.exists() else ""
        except zipfile.BadZipFile:
            pass
    return ""


def themes():
    build_ours()
    seen, res = set(), []
    for base in DIRS:
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if d.name in seen or not ((d / "cursors").is_dir() or (d / "hyprcursors").is_dir()):
                continue
            seen.add(d.name)
            kind = "accent" if d.name == ACCENT else "ours" if d.name == OURS else "imported" if (d / ".thenotch-imported").exists() else "user" if base != DIRS[-1] else "system"
            res.append({"name": d.name, "kind": kind, "preview": preview(d), "path": str(d)})
    return res


def current():
    try:
        st = json.loads(STATE.read_text())
    except (OSError, ValueError):
        st = {}
    g = run(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"]).stdout.strip().strip("'")
    s = run(["gsettings", "get", "org.gnome.desktop.interface", "cursor-size"]).stdout.strip()
    return {"theme": st.get("theme") or g, "size": int(st.get("size") or (s if s.isdigit() else 24)),
            "accent": dict({"base": OURS, "colour": "theme", "variant": "fill"}, **(st.get("accent") or {})), "themeAccent": theme_accent()}


def persist(name, size):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({"theme": name, "size": size}))
    text = LOOK.read_text() if LOOK.exists() else ""
    block = (f'{BEGIN}\n-- Written by TheNotch (Settings → Input → Cursor). Delete this block to undo.\n'
             f'hl.env("XCURSOR_THEME", {json.dumps(name)})\nhl.env("XCURSOR_SIZE", "{size}")\n'
             f'hl.env("HYPRCURSOR_THEME", {json.dumps(name)})\nhl.env("HYPRCURSOR_SIZE", "{size}")\n{END}\n')
    if BEGIN in text and END in text:
        text = re.sub(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", block, text, flags=re.S)
    else:
        text = text.rstrip("\n") + "\n\n" + block
    LOOK.write_text(text)
    HOOK.parent.mkdir(parents=True, exist_ok=True)
    HOOK.write_text(f"#!/bin/bash\n# TheNotch: re-apply the chosen cursor at login\nhyprctl setcursor {json.dumps(name)} {size} >/dev/null 2>&1\n")
    HOOK.chmod(0o755)


def unpersist():
    STATE.unlink(missing_ok=True)
    if LOOK.exists():
        LOOK.write_text(re.sub(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "", LOOK.read_text(), flags=re.S))
    HOOK.unlink(missing_ok=True)


def apply(name, size):
    if name == ACCENT:
        return accent(size=size)
    ACCENT_HOOK.unlink(missing_ok=True)                    # not following the theme any more
    r = run(["hyprctl", "setcursor", name, str(size)])
    persist(name, size)
    run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", name])
    run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(size)])
    return out({"ok": r.returncode == 0, "error": r.stderr.strip()})


def downloads():
    res, have = [], {(USER_ICONS / d / ".thenotch-imported").read_text() for d in os.listdir(USER_ICONS)
                     if (USER_ICONS / d / ".thenotch-imported").exists()} if USER_ICONS.exists() else set()
    for z in sorted((HOME / "Downloads").glob("*.zip"), key=lambda p: -p.stat().st_mtime)[:60]:
        try:
            names = zipfile.ZipFile(z).namelist()
        except (zipfile.BadZipFile, OSError):
            continue
        n = sum(1 for x in names if x.lower().endswith((".ani", ".cur")))
        if n:
            res.append({"zip": str(z), "name": z.stem, "cursors": n, "imported": str(z) in have})
    return res


def main():
    a = sys.argv[1:]
    c = a[0] if a else "list"
    if c == "list":
        return out({"ok": True, "themes": themes(), "current": current()})
    if c == "downloads":
        return out({"ok": True, "packs": downloads()})
    if c == "current":
        return out({"ok": True, **current()})
    if c == "apply" and len(a) > 1:
        return apply(a[1], int(a[2]) if len(a) > 2 else current()["size"])
    if c == "import" and len(a) > 1:
        return import_zip(a[1], a[2] if len(a) > 2 else None)
    if c == "accent":             # accent [BASE] [COLOUR|theme] [VARIANT]
        return accent(a[1] if len(a) > 1 else None, a[2] if len(a) > 2 else None, None, a[3] if len(a) > 3 else None)
    if c == "reimport":           # rebuild imported packs in every size
        done = []
        for d in USER_ICONS.iterdir() if USER_ICONS.exists() else []:
            z = d / ".thenotch-imported"
            if z.exists() and Path(z.read_text()).exists():
                with open(os.devnull, "w") as null:
                    so, sys.stdout = sys.stdout, null
                    try:
                        import_zip(z.read_text(), d.name)
                    finally:
                        sys.stdout = so
                done.append(d.name)
        return out({"ok": True, "rebuilt": done})
    if c == "accent-refresh":
        if not accent_state() and json.loads(STATE.read_text() or "{}").get("theme") != ACCENT:
            return out({"ok": True})
        return accent()
    if c == "delete" and len(a) > 1:
        d = USER_ICONS / a[1]
        if (d / ".thenotch-imported").exists():
            shutil.rmtree(d)
            return out({"ok": True})
        return out({"ok": False, "error": "only imported themes can be deleted here"})
    print(__doc__, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
