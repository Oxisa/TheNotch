#!/usr/bin/env bash
# Who is using the microphone and the camera right now, as JSON:
#   {"mic":[{"app","bin","pid"}], "cam":[...]}
#   privctl cam   only the processes holding /dev/video* (TheNotch runs this
#                 when inotify sees a camera opened or closed; the microphone
#                 and portal cameras it reads from PipeWire itself)
# Microphone: a capture stream fed by a real source (not a speaker's monitor —
# visualizers listen to those). Camera: a process holding /dev/video*, or a
# PipeWire video capture stream (browsers through the portal).
if [[ ${1:-} == cam ]]; then
  for d in /dev/video*; do fuser "$d" 2>/dev/null; done | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -u |
    while read -r pid; do
      b=$(basename "$(readlink -f /proc/$pid/exe 2>/dev/null)")
      [[ $b == pipewire || $b == wireplumber || -z $b ]] && continue
      jq -cn --arg app "$b" --argjson pid "$pid" '{app:$app, bin:$app, pid:$pid}'
    done | jq -sc '{cam: unique_by(.app)}'
  exit 0
fi
dump=$(pw-dump 2>/dev/null)
mic=$(jq -c '
  [.[] | select(.type=="PipeWire:Interface:Node")] as $n
  | ($n | map({key: (.id|tostring), value: .info.props}) | from_entries) as $p
  | [.[] | select(.type=="PipeWire:Interface:Link" and .info.state=="active") | .info] as $l
  | [ $n[] | select(.info.props["media.class"]=="Stream/Input/Audio" and .info.state=="running")
      | select((.info.props["node.name"]//"") | startswith("soundhub_") | not)
      | . as $s
      | select(any($l[]; ."input-node-id"==$s.id and ((($p[(."output-node-id"|tostring)]["media.class"])//"") | startswith("Audio/Source"))))
      | {app: (.info.props["application.name"] // .info.props["node.name"] // "?"),
         bin: (.info.props["application.process.binary"] // ""),
         pid: ((.info.props["application.process.id"] // 0) | tonumber? // 0)} ]
  | unique_by(.app)' <<<"$dump")
cam=$(
  { for d in /dev/video*; do fuser "$d" 2>/dev/null; done | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -u |
      while read -r pid; do
        b=$(basename "$(readlink -f /proc/$pid/exe 2>/dev/null)"); c=$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | cut -c1-80)
        [[ $b == pipewire || $b == wireplumber || -z $b ]] && continue
        jq -cn --arg app "$b" --arg bin "$b" --argjson pid "$pid" '{app:$app, bin:$bin, pid:$pid}'
      done
    jq -c '.[] | select(.type=="PipeWire:Interface:Node") | .info | select(.props["media.class"]=="Stream/Input/Video" and .state=="running")
      | {app: (.props["application.name"] // .props["node.name"] // "?"), bin: (.props["application.process.binary"] // ""), pid: ((.props["application.process.id"] // 0) | tonumber? // 0)}' <<<"$dump"
  } | jq -sc 'unique_by(.app)')
jq -cn --argjson mic "${mic:-[]}" --argjson cam "${cam:-[]}" '{mic:$mic, cam:$cam}'
